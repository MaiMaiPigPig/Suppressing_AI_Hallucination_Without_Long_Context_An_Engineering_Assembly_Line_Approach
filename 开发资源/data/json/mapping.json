    "category": "# ========== 三、等级引用 ==========",
    "expr": "",
    "meaning": "",
    "example": ""
  },
  {
    "category": "等级引用",
    "expr": "lv:class([职业id])",
    "meaning": "某职业的当前等级",
    "example": "lv:class(6) 表示武僧的等级（6=武僧）"
  },
  {
    "category": "等级条件",
    "expr": "lv:class([职业id])=[数值]",
    "meaning": "等级等于某值",
    "example": "lv:class(6)=10 表示武僧等级=10时"
  },
  {
    "category": "等级运算",
    "expr": "lv:class([职业id])*[倍数]>[取整方向]",
    "meaning": "等级倍率计算（↑=向上取整,↓=向下取整）",
    "example": "lv:class(1)*0.5>↓ 表示野蛮人等级的一半向下取整"
  },
  {
    "category": "# ========== 四、数值运算 ==========",
    "expr": "",
    "meaning": "",
    "example": ""
  },
  {
    "category": "数值运算-加数量",
    "expr": "[表名]+[数值]",
    "meaning": "某表数据数量增加",
    "example": "tool(type=67)+3 表示获得3种乐器熟练"
  },
  {
    "category": "数值运算-公式",
    "expr": "[数值]d[面数]+[调整值]",
    "meaning": "骰子公式",
    "example": "1d10+lv:class(5) 表示1d10+战士等级"
  },
  {
    "category": "# ========== 五、熟练与专精 ==========",
    "expr": "",
    "meaning": "",
    "example": ""
  },
  {
    "category": "熟练转专精",
    "expr": "Proficiency>pure",
    "meaning": "将熟练升级为专精",
    "example": "Proficiency>pure 表示将某项熟练变为专精"
  },
  {
    "category": "熟练转专精-指定",
    "expr": "Proficiency>pure([技能id1],[技能id2])",
    "meaning": "指定技能升级为专精",
    "example": "Proficiency>pure(11,12) 表示将奥秘和历史升级为专精"
  },
  {
    "category": "熟练转专精-加数量",
    "expr": "Proficiency>pure+[数值]",
    "meaning": "获得N个专精",
    "example": "Proficiency>pure+2 表示获得2个专精"
  },
  {
    "category": "技能熟练增加",
    "expr": "技能+[数值]",
    "meaning": "获得N个技能熟练",
    "example": "技能+1 表示获得1个技能熟练"
  },
  {
    "category": "工具熟练增加",
    "expr": "tool(type=[类型id])+[数值]",
    "meaning": "获得N个某类型工具熟练",
    "example": "tool(type=66)+1 表示获得1个工匠工具熟练"
  },
  {
    "category": "熟练转专精-指定-加数量",
    "expr": "Proficiency>pure([技能id1],[技能id2])",
    "meaning": "指定技能升级为专精",
    "example": "Proficiency>pure(11,12)+1 表示将奥秘和历史中选一个转为专精"
  },
  {
    "category": "武器熟练转精通",
    "expr": "Weapon>mastery",
    "meaning": "获得武器精通",
    "example": "从职业熟练的武器中选N个获得精通词条，数量由 proficiency_link 决定"
  },
